# Port for the API server
PORT=4000

# Leave empty to use the built-in JSON file store (data/db.json).
# Set a MongoDB connection string to use MongoDB instead, for example
# mongodb://127.0.0.1:27017 or a MongoDB Atlas URI.
MONGODB_URI=
MONGODB_DB=dharohar

# Where the file store keeps its data when MONGODB_URI is empty
DATA_FILE=data/db.json

# Comma separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# Enables GET /api/quiz/admin/stats (send it in the X-Admin-Key header). Leave empty to disable.
ADMIN_KEY=

# Optional machine translation service (IndicTrans2) for Punjabi and Urdu question text.
# POST { texts, source, target } -> { translations }. Hindi is hand-translated and needs nothing.
TRANSLATE_URL=

# Accounts. AUTH_SECRET signs login tokens and is REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# How long a login lasts, in days
AUTH_TOKEN_DAYS=30
# Google sign-in: create an OAuth client (type "Web application") in Google
# Cloud Console, add your site origin under "Authorized JavaScript origins",
# and paste the client id here. The website reads it from /api/auth/config.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# ─── Verification codes (OTP) ───────────────────────────────────────────────
# Sign up needs a code sent to the email AND the phone. Password reset uses email.
# Without the keys below, codes are printed in this server's console and shown
# on the website as "demo mode". That only works when NODE_ENV is not production.

# Email: Brevo (free 300/day, verify one sender address) or Resend
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Dharohar

# SMS: Twilio (trial sends to verified numbers only) or Fast2SMS (India, OTP route)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAST2SMS_API_KEY=
